{
  "$schema": "../../../schemas/recipe.schema.json",
  "id": "header",
  "platform": "app",
  "contractVersion": "0.2.0",
  "description": "RN 実装（src/components/Header.tsx）の具象レシピ（styleRefs 形式）。containerStyle は横並び（leading? / title / trailing?）+ 下 border。title は melta の Text（variant=\"xl\" weight=\"bold\" color=\"text-heading\" role=\"heading\"）を compose するため titleStyle は持たない（typography は text recipe が正）。titleWrapStyle の flex:1 で title が余白を占有し trailing を右端へ押す。 actionsはdefaultの外側余白・下線・titleWrapを保ち、中央spacer前後のgapだけspacing.1に抑え、hiddenTitleStyleでa11y見出しだけを視覚的に隠す。",
  "variants": {
    "default": {
      "containerStyle": {
        "flexDirection": "row",
        "alignItems": "center",
        "gap": {
          "token": "spacing.3"
        },
        "paddingHorizontal": {
          "token": "spacing.4"
        },
        "paddingVertical": {
          "token": "spacing.3"
        },
        "backgroundColor": {
          "token": "color.semantic.light.bg-page"
        },
        "borderBottomWidth": 1,
        "borderBottomColor": {
          "token": "color.semantic.light.border-default"
        }
      },
      "titleWrapStyle": {
        "flex": 1
      }
    },
    "actions": {
      "containerStyle": {
        "flexDirection": "row",
        "alignItems": "center",
        "gap": {
          "token": "spacing.1"
        },
        "paddingHorizontal": {
          "token": "spacing.4"
        },
        "paddingVertical": {
          "token": "spacing.3"
        },
        "backgroundColor": {
          "token": "color.semantic.light.bg-page"
        },
        "borderBottomWidth": 1,
        "borderBottomColor": {
          "token": "color.semantic.light.border-default"
        }
      },
      "titleWrapStyle": {
        "flex": 1
      },
      "hiddenTitleStyle": {
        "position": "absolute",
        "width": 1,
        "height": 1,
        "overflow": "hidden"
      }
    }
  },
  "sizes": {},
  "states": {}
}
