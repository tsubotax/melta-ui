{
  "$schema": "../../../schemas/recipe.schema.json",
  "id": "header",
  "platform": "app",
  "contractVersion": "0.3.0",
  "description": "RN 実装（src/components/Header.tsx）の具象レシピ（styleRefs 形式）。title は melta の Text を compose するため titleStyle は持たない（typography は text recipe が正）。default/actions は variant=\"xl\" weight=\"bold\" color=\"text-heading\" role=\"heading\"。default の横並び・外側余白・下線・titleWrapStyle の flex:1 を actions も保ち、中央spacer前後のgapだけspacing.1に抑え、hiddenTitleStyleでa11y見出しを視覚的に隠す。centered/navigation は Text variant=\"lg\" を既定、長い動的タイトルは \"base\" とし、独立した見出しgroupに置く。等幅の左右slotと縮小可能なタイトル領域を持ち、最小高44でフォント拡大を許す。navigation の borderBottomWidth:1 は密度1での値で、実機ではStyleSheet.hairlineWidthをresolverへ渡す。centered は下線を持たず横余白は親が持つ。",
  "variants": {
    "default": {
      "containerStyle": {
        "flexDirection": "row",
        "alignItems": "center",
        "gap": {
          "token": "spacing.3"
        },
        "paddingHorizontal": {
          "token": "spacing.4"
        },
        "paddingVertical": {
          "token": "spacing.3"
        },
        "backgroundColor": {
          "token": "color.semantic.light.bg-page"
        },
        "borderBottomWidth": 1,
        "borderBottomColor": {
          "token": "color.semantic.light.border-default"
        }
      },
      "titleWrapStyle": {
        "flex": 1
      }
    },
    "actions": {
      "containerStyle": {
        "flexDirection": "row",
        "alignItems": "center",
        "gap": {
          "token": "spacing.1"
        },
        "paddingHorizontal": {
          "token": "spacing.4"
        },
        "paddingVertical": {
          "token": "spacing.3"
        },
        "backgroundColor": {
          "token": "color.semantic.light.bg-page"
        },
        "borderBottomWidth": 1,
        "borderBottomColor": {
          "token": "color.semantic.light.border-default"
        }
      },
      "titleWrapStyle": {
        "flex": 1
      },
      "hiddenTitleStyle": {
        "position": "absolute",
        "width": 1,
        "height": 1,
        "overflow": "hidden"
      }
    },
    "centered": {
      "containerStyle": {
        "flexDirection": "row",
        "alignItems": "center",
        "minHeight": 44
      },
      "titleWrapStyle": {
        "flexShrink": 1,
        "minWidth": 0
      },
      "leadingStyle": {
        "flex": 1,
        "minWidth": 44,
        "flexDirection": "row",
        "justifyContent": "flex-start"
      },
      "trailingStyle": {
        "flex": 1,
        "minWidth": 44,
        "flexDirection": "row",
        "justifyContent": "flex-end"
      }
    },
    "navigation": {
      "containerStyle": {
        "flexDirection": "row",
        "alignItems": "center",
        "minHeight": 44,
        "paddingHorizontal": {
          "token": "spacing.4"
        },
        "borderBottomWidth": 1,
        "borderBottomColor": {
          "token": "color.semantic.light.border-default"
        }
      },
      "titleWrapStyle": {
        "flexShrink": 1,
        "minWidth": 0
      },
      "leadingStyle": {
        "flex": 1,
        "minWidth": 44,
        "flexDirection": "row",
        "justifyContent": "flex-start"
      },
      "trailingStyle": {
        "flex": 1,
        "minWidth": 44,
        "flexDirection": "row",
        "justifyContent": "flex-end"
      }
    }
  },
  "sizes": {},
  "states": {}
}
