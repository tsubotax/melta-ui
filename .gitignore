.DS_Store
# .claude/ は settings.json（hook 登録 = DS の enforcement 層）と
# screendiff.json（melta-screendiff のPR視覚比較設定）だけ配布する
.claude/*
!.claude/settings.json
!.claude/screendiff.json
.vscode/
.netlify/
node_modules/
.env
.env.*
dist/
verification/
site-public/
.agents/
skills-lock.json

# チームレビュー一時ファイル
.team/

# ベンチマーク生成物
design/benchmarks/results/

# shadow judge の run 生成物（git に残る正本は design/judge/history.json）
design/judge/results/

# melta-screendiff の撮影・比較HTML出力
output/screendiff/

# loop ランタイム監査ログ（playbook の Audit Log: .melta-loop/runs.jsonl）
.melta-loop/

# 内部開発ファイル
internal/
commands/
skills/skill-improver/
skills/design-review/iterations/
skills/design-review/tasks/
docs/phase1-2-diff-report.html
test-results/
docs/talks/
tests/fixtures/reset-vrt-generated/
